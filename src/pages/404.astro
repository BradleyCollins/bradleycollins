---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
  <section class="mx-auto max-w-3xl px-4 py-32 text-center">
    <h1 class="font-mono text-6xl font-bold text-brand">404</h1>
    <p class="mt-4 text-mist">That page doesn't exist.</p>
    <a href="/" class="mt-8 inline-block rounded-md bg-brand px-5 py-3 font-mono font-bold text-ink hover:bg-paper">Go home</a>
  </section>
</BaseLayout>
